<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#663C8A58" />
            <stroke android:width="2dp" android:color="#FFE6F6E8" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#30252E38" android:endColor="#18252E38" />
            <stroke android:width="1dp" android:color="#A6FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
